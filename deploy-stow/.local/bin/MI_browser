#!/usr/bin/env bash
#
# MI_browser
#
# Lanzador universal de navegadores OCI aislados mediante Podman.
#
# Características:
#   - Wayland nativo universal (Gecko/Firefox, Chromium/Brave, Qt).
#   - Perfil persistente.
#   - Mapeo opcional de descargas (agnóstico al navegador).
#   - Red normal, Tor o Gluetun.
#   - Audio opcional.
#   - USB opcional.
#   - Imagen OCI configurable.
#
# Compatible con ShellCheck.
#

set -Eeuo pipefail

##########################################################################
# Constantes
##########################################################################

readonly DEFAULT_IMAGE="localhost/brave:pro"
readonly DEFAULT_CONTAINER="browser"
readonly DEFAULT_NETWORK="normal"

##########################################################################
# Variables
##########################################################################

MI_IMAGE_NAME="$DEFAULT_IMAGE"
MI_CONTAINER_NAME="$DEFAULT_CONTAINER"

MI_PROFILE_PATH=""
MI_DOWNLOADS_PATH=""
MI_NETWORK_TYPE="$DEFAULT_NETWORK"

MI_ENABLE_AUDIO=0
MI_ENABLE_USB=0

MI_TIMEZONE=""

VPN_INSTANCE=""
VPN_SERVICE=""
VPN_CONTAINER=""

MI_PODMAN_NET_FLAGS=()
MI_EXTRA_PODMAN_FLAGS=()
MI_BROWSER_FLAGS=()

##########################################################################
# Ayuda
##########################################################################

usage() {
  cat <<EOF
Uso:
    MI_browser --profile PERFIL [opciones] [-- argumentos_navegador]

Lanzador universal y agnóstico de navegadores sobre Wayland (Gecko, Chromium, Qt).

Opciones:
  -p, --profile DIR
        Directorio del perfil (obligatorio). Se montará en /home/browser.
  -d, --downloads DIR
        Directorio host para descargas (opcional). Se montará en /home/browser/Downloads.
  -c, --container NAME
        Nombre del contenedor. (por defecto: ${DEFAULT_CONTAINER})
  -i, --image IMAGE
        Imagen OCI. (por defecto: ${DEFAULT_IMAGE})
  -n, --network MODE
        Tipo de red:
            normal
            tor
            vpn:INSTANCIA
  -t, --tz ZONA
        Zona horaria.
      --audio
        Habilita sonido (PulseAudio/PipeWire).
      --usb
        Permite acceso a dispositivos USB.
  -h, --help
        Muestra esta ayuda.

Compatibilidad e Integración:
  El script fuerza Wayland nativo usando variables de entorno globales
  (MOZ_ENABLE_WAYLAND, ELECTRON_OZONE_PLATFORM_HINT, QT_QPA_PLATFORM).
  Cualquier navegador (Brave, Firefox, Mullvad, etc.) o aplicación ignorará
  las variables que no le correspondan de forma segura y sin generar errores.

Argumentos del Navegador:
  Flags como --class=..., --name=... o URLs se pasarán directamente al navegador.

Ejemplo:
    MI_browser \\
        --profile ~/perfiles/banco \\
        --downloads ~/Descargas/banco \\
        --network vpn:trabajo \\
        --audio \\
        --class="banco-app" \\
        https://example.com
EOF
}

##########################################################################
# Limpieza
##########################################################################

cleanup() {
  podman rm -f "$MI_CONTAINER_NAME" >/dev/null 2>&1 || true
}

##########################################################################
# Dependencias
##########################################################################

check_dependencies() {
  local cmd
  for cmd in podman realpath systemctl; do
    command -v "$cmd" >/dev/null || {
      echo "ERROR: '$cmd' no está instalado." >&2
      exit 1
    }
  done
}

##########################################################################
# Parseo de argumentos
##########################################################################

parse_args() {
  while (($#)); do
    case "$1" in
    -p | --profile)
      MI_PROFILE_PATH="$2"
      shift 2
      ;;
    -d | --downloads)
      MI_DOWNLOADS_PATH="$2"
      shift 2
      ;;
    -c | --container)
      MI_CONTAINER_NAME="$2"
      shift 2
      ;;
    -i | --image)
      MI_IMAGE_NAME="$2"
      shift 2
      ;;
    -n | --network)
      MI_NETWORK_TYPE="$2"
      shift 2
      ;;
    -t | --tz)
      MI_TIMEZONE="$2"
      shift 2
      ;;
    --audio)
      MI_ENABLE_AUDIO=1
      shift
      ;;
    --usb)
      MI_ENABLE_USB=1
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      MI_BROWSER_FLAGS+=("$@")
      break
      ;;
    *)
      echo "ERROR: opción desconocida: $1" >&2
      echo "Si deseas pasar argumentos al navegador, utiliza '--'." >&2
      exit 1
      ;;
    esac
  done
}

##########################################################################
# Validaciones
##########################################################################

validate() {
  [[ -n "$MI_PROFILE_PATH" ]] || {
    echo "ERROR: --profile es obligatorio." >&2
    exit 1
  }
  mkdir -p "$MI_PROFILE_PATH"
  MI_PROFILE_PATH=$(realpath "$MI_PROFILE_PATH")

  if [[ -n "$MI_DOWNLOADS_PATH" ]]; then
    mkdir -p "$MI_DOWNLOADS_PATH"
    MI_DOWNLOADS_PATH=$(realpath "$MI_DOWNLOADS_PATH")
  fi

  if ! podman image exists "$MI_IMAGE_NAME"; then
    echo "ERROR: La imagen '$MI_IMAGE_NAME' no existe." >&2
    exit 1
  fi
  [[ -n "${WAYLAND_DISPLAY:-}" ]] || {
    echo "ERROR: WAYLAND_DISPLAY no está definido." >&2
    exit 1
  }
  [[ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]] || {
    echo "ERROR: Socket Wayland no encontrado." >&2
    exit 1
  }
}

##########################################################################
# Configuración de red
##########################################################################

setup_network() {
  case "$MI_NETWORK_TYPE" in
  normal)
    MI_PODMAN_NET_FLAGS+=(--network=slirp4netns)
    ;;

  tor)
    MI_PODMAN_NET_FLAGS+=(--network=slirp4netns)
    MI_BROWSER_FLAGS+=(
      --proxy-server=socks5://10.0.2.2:9050
    )
    ;;
  vpn:*)
    VPN_INSTANCE="${MI_NETWORK_TYPE#vpn:}"
    [[ -n "$VPN_INSTANCE" ]] || {
      echo "ERROR: Instancia VPN vacía." >&2
      exit 1
    }
    VPN_SERVICE="vpngluetunpod@${VPN_INSTANCE}.service"
    VPN_CONTAINER="systemd-vpngluetunpod_${VPN_INSTANCE}"
    if ! systemctl --user is-active --quiet "$VPN_SERVICE"; then
      echo "Iniciando VPN '$VPN_INSTANCE'..."
      systemctl --user start "$VPN_SERVICE"
      local i
      for ((i = 0; i < 20; i++)); do
        if systemctl --user is-active --quiet "$VPN_SERVICE"; then
          break
        fi
        sleep 0.5
      done
      systemctl --user is-active --quiet "$VPN_SERVICE" || {
        echo "ERROR: No pudo iniciarse la VPN." >&2
        exit 1
      }
    fi
    MI_PODMAN_NET_FLAGS+=(
      --network="container:${VPN_CONTAINER}"
    )
    ;;
  *)
    echo "ERROR: Red '$MI_NETWORK_TYPE' no soportada." >&2
    exit 1
    ;;
  esac
}

##########################################################################
# Hardware y almacenamiento opcional
##########################################################################

setup_optional_features() {
  if ((MI_ENABLE_USB)); then
    MI_EXTRA_PODMAN_FLAGS+=(
      --device
      /dev/bus/usb
    )
  fi

  if ((MI_ENABLE_AUDIO)); then
    if [[ -S "$XDG_RUNTIME_DIR/pulse/native" ]]; then
      MI_EXTRA_PODMAN_FLAGS+=(
        -v
        "$XDG_RUNTIME_DIR/pulse/native:/tmp/pulse/native:ro"
        -e
        PULSE_SERVER=unix:/tmp/pulse/native
      )
    else
      echo "Aviso: no se encontró socket PulseAudio/PipeWire."
    fi
  fi

  if [[ -n "$MI_TIMEZONE" ]]; then
    MI_EXTRA_PODMAN_FLAGS+=(
      -e
      "TZ=$MI_TIMEZONE"
    )
  fi

  # Montaje del directorio de descargas opcional
  if [[ -n "$MI_DOWNLOADS_PATH" ]]; then
    MI_EXTRA_PODMAN_FLAGS+=(
      -v
      "$MI_DOWNLOADS_PATH:/home/browser/Downloads:Z"
    )
  fi
}

##########################################################################
# Ejecución del contenedor
##########################################################################

run_container() {
  # Elimina cualquier contenedor previo con el mismo nombre.
  podman rm -f "$MI_CONTAINER_NAME" >/dev/null 2>&1 || true

  echo "========================================"
  echo "Contenedor : $MI_CONTAINER_NAME"
  echo "Imagen     : $MI_IMAGE_NAME"
  echo "Perfil     : $MI_PROFILE_PATH"
  if [[ -n "$MI_DOWNLOADS_PATH" ]]; then
    echo "Descargas  : $MI_DOWNLOADS_PATH"
  else
    echo "Descargas  : No mapeado (Aislado dentro del perfil)"
  fi
  echo "Red        : $MI_NETWORK_TYPE"
  echo "Audio      : $((MI_ENABLE_AUDIO ? 1 : 0))"
  echo "USB        : $((MI_ENABLE_USB ? 1 : 0))"
  echo "========================================"

  local cmd=(
    podman run
    --detach
    --rm
    --name "$MI_CONTAINER_NAME"
    --shm-size=1g
    --userns=keep-id
    --security-opt label=disable
    --security-opt no-new-privileges
    --device /dev/dri/renderD128
    # ------------------------------------------------------------------
    # ENTORNO GRÁFICO Y NATIVO WAYLAND (Propósito General)
    # ------------------------------------------------------------------
    -v "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY:/tmp/$WAYLAND_DISPLAY:ro,z"
    -e WAYLAND_DISPLAY="$WAYLAND_DISPLAY"
    -e XDG_RUNTIME_DIR=/tmp
    -e XDG_SESSION_TYPE=wayland

    # Mozilla / Gecko (Firefox, Mullvad, LibreWolf, Tor Browser)
    -e MOZ_ENABLE_WAYLAND=1

    # Chromium / Electron (Brave, Chrome, Vivaldi, Edge)
    -e ELECTRON_OZONE_PLATFORM_HINT=wayland

    # Frameworks Qt (Falkon, qBittorrent, etc.)
    -e QT_QPA_PLATFORM=wayland

    # ------------------------------------------------------------------
    # PERSISTENCIA DE DATOS Y CONFIGURACIONES EXTRA
    # ------------------------------------------------------------------
    -v "$MI_PROFILE_PATH:/home/browser:Z"
    "${MI_PODMAN_NET_FLAGS[@]}"
    "${MI_EXTRA_PODMAN_FLAGS[@]}"
    "$MI_IMAGE_NAME"
    # Argumentos pasados al navegador
    "${MI_BROWSER_FLAGS[@]}"
  )

  echo
  echo "Comando ejecutado:"
  printf ' %q' "${cmd[@]}"
  echo
  echo

  "${cmd[@]}" >"$MI_PROFILE_PATH/container.id"
}

##########################################################################
# Programa principal
##########################################################################

main() {
  check_dependencies
  parse_args "$@"
  validate
  setup_network
  setup_optional_features
  run_container
}

main "$@"
